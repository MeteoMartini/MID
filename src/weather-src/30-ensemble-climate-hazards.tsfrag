function ensembleRetryDelay(ms:number,signal?:AbortSignal){return new Promise<void>((resolve,reject)=>{if(signal?.aborted){reject(new DOMException('Abgebrochen','AbortError'));return}const timer=setTimeout(resolve,ms);signal?.addEventListener('abort',()=>{clearTimeout(timer);reject(new DOMException('Abgebrochen','AbortError'))},{once:true})})}
async function fetchEnsembleRequest(url:string,signal?:AbortSignal,priority:OpenMeteoPriority='normal'){
 try{return await guardedOpenMeteoJson<Weather>(url,{signal,cache:'no-store'},{priority,maxRetries:priority==='background'?0:1})}
 catch(error){if(signal?.aborted)throw error;if(isOpenMeteoRateLimitError(error))throw error;await ensembleRetryDelay(450,signal);return guardedOpenMeteoJson<Weather>(url,{signal,cache:'no-store'},{priority,maxRetries:0,dedupe:false})}
}
const AIFS_EUROPE_AUDIT_FIELDS=['cloud_cover','cloud_cover_low','cloud_cover_mid','cloud_cover_high'] as const;
function ensembleVariablesForContract(modelId:string,variables:string){if(modelId!=='ecmwf_aifs_europe_ensemble')return variables;const rows=variables.split(',').map(value=>value.trim()).filter(Boolean);for(const field of AIFS_EUROPE_AUDIT_FIELDS)if(!rows.includes(field))rows.push(field);return rows.join(',')}
function ensembleFieldValues(weather:Weather,field:string){const pattern=new RegExp(`^${field}(?:_member[0-9]+)?$`);return Object.entries(weather.hourly??{}).filter(([key])=>pattern.test(key)).flatMap(([,values])=>Array.isArray(values)?values.map(n).filter(Number.isFinite):[])}
export function aifsEuropeEnsembleContractValid(weather:Weather){const precipitation=ensembleFieldValues(weather,'precipitation');if(precipitation.length<12||precipitation.some(value=>value<0||value>500))return false;for(const field of AIFS_EUROPE_AUDIT_FIELDS){const values=ensembleFieldValues(weather,field);if(values.length<12||values.some(value=>value<0||value>100))return false}return true}
async function fetchEnsembleWeather(lat:number,lon:number,forecastDays:number,modelId:string,signal?:AbortSignal,hourly='temperature_2m,precipitation,wind_speed_10m,wind_gusts_10m,sunshine_duration',priority:OpenMeteoPriority='normal'){
