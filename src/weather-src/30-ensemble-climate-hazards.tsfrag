 const activeModels=results.map(x=>x.model),runs=await ensembleModelRunMetas(loaded.attempts,selected,signal),days=aggregateMembers(results,runs),scenarios=buildEnsembleScenarios(results,days);
 if(days.length>=7){const value={days:days.slice(0,14),models:activeModels.map(x=>x.label),runs,scenarios,bootstrap:false} satisfies EnsembleForecastBundle;writeEnsembleCache(lat,lon,value);return value}
 const fallback=await meanFallback(lat,lon,signal,priority);if(fallback.days.length>=5){const value={...fallback,bootstrap:false} satisfies EnsembleForecastBundle;writeEnsembleCache(lat,lon,value);return value}
 if(days.length){const value={days,models:activeModels.map(x=>x.label),runs,scenarios,bootstrap:false} satisfies EnsembleForecastBundle;writeEnsembleCache(lat,lon,value);return value}
 if(cache)return{days:cache.days,models:[...cache.models,'lokaler letzter erfolgreicher Stand'],runs:cache.runs,scenarios:cache.scenarios??[],bootstrap:false};
 const failedCount=loaded.attempts.filter(row=>row.status==='unavailable'||row.status==='adapter-not-configured').length;throw new Error(`Keine ausreichend vollständigen Ensemble-Daten: ${failedCount} priorisierte Mitgliedermodell-Abrufe bzw. Adapterpfade waren nicht nutzbar; die offizielle Ensemble-Mittel-/Spread-Reserve lieferte ebenfalls keine auswertbare Tagesreihe.`);
}

const WARNING_ENSEMBLE_CACHE_PREFIX='mid:warning-ensemble-neighborhood:v2:';
const WARNING_ENSEMBLE_FRESH_MS=35*60*1000;
const WARNING_ENSEMBLE_STALE_MS=2*60*60*1000;
type WarningEnsembleModelHour={time:string;epoch:number;centerGust:number[];neighborhoodGust:number[];centerPrecipitation:number[];neighborhoodPrecipitation:number[];centerTemperature:number[];neighborhoodTemperatureLow:number[];neighborhoodTemperatureHigh:number[]};
type WarningEnsembleModelResult={model:EnsembleModel;hours:WarningEnsembleModelHour[]};
function warningEnsembleCacheKey(lat:number,lon:number){return`${WARNING_ENSEMBLE_CACHE_PREFIX}${(Math.round(lat*50)/50).toFixed(2)}:${(Math.round(lon*50)/50).toFixed(2)}`}
function readWarningEnsembleCache(lat:number,lon:number,maxAge=WARNING_ENSEMBLE_STALE_MS){try{const raw=localStorage.getItem(warningEnsembleCacheKey(lat,lon));if(!raw)return null;const parsed=JSON.parse(raw) as {created:number;value:WarningEnsembleSupport},ageMs=Date.now()-Number(parsed.created);if(!parsed?.value||!Array.isArray(parsed.value.hours)||!Number.isFinite(ageMs)||ageMs<0||ageMs>maxAge)return null;return{...parsed.value,cached:true,ageMs}}catch{return null}}
function writeWarningEnsembleCache(lat:number,lon:number,value:WarningEnsembleSupport){try{localStorage.setItem(warningEnsembleCacheKey(lat,lon),JSON.stringify({created:Date.now(),value}))}catch{}}
function warningNeighborhoodPoints(lat:number,lon:number,radiusKm:number){const latDelta=radiusKm/111.2,lonScale=Math.max(.18,Math.cos(lat*Math.PI/180)),lonDelta=radiusKm/(111.2*lonScale);return[{lat,lon},{lat:lat+latDelta,lon},{lat,lon:lon+lonDelta},{lat:lat-latDelta,lon},{lat,lon:lon-lonDelta}]}
function warningEnsembleModels(lat:number,lon:number){const ordered=orderedModels(ensembleModels.filter(model=>!DIRECT_REGIONAL_ENSEMBLE_MODELS.has(model.id)&&model.maxDays>=2&&modelApplies(model,lat,lon)),ensemblePriority),selected:EnsembleModel[]=[],groups=new Set<string>();for(const model of ordered){if(groups.has(model.independenceGroup))continue;groups.add(model.independenceGroup);selected.push(model);if(selected.length>=2)break}return selected}
function warningEnsembleMemberSuffixes(weather:Weather){const suffixes=new Set<string>();for(const key of Object.keys(weather.hourly??{})){const match=key.match(/^(?:temperature_2m|precipitation|wind_gusts_10m)(_member\d+)?$/);if(match)suffixes.add(match[1]??'')}return[...suffixes]}
function warningEnsembleValue(weather:Weather,field:string,suffix:string,index:number){const values=weather.hourly?.[`${field}${suffix}`]??[],raw=values[index],value=raw===null||raw===undefined||String(raw).trim()===''?NaN:Number(raw);return Number.isFinite(value)?value:NaN}
async function fetchWarningEnsembleModel(model:EnsembleModel,lat:number,lon:number,radiusKm:number,signal?:AbortSignal):Promise<WarningEnsembleModelResult|null>{
 const points=warningNeighborhoodPoints(lat,lon,radiusKm),params=new URLSearchParams({latitude:points.map(point=>point.lat.toFixed(5)).join(','),longitude:points.map(point=>point.lon.toFixed(5)).join(','),timezone:'GMT',forecast_days:'3',models:model.id,hourly:'temperature_2m,precipitation,wind_gusts_10m',wind_speed_unit:'kn'}),payload=await guardedOpenMeteoJson<Weather|Weather[]>(`https://ensemble-api.open-meteo.com/v1/ensemble?${params}`,{signal,cache:'no-store'},{priority:'background',maxRetries:0}),locations=Array.isArray(payload)?payload:[payload],center=locations[0];
 if(!center||locations.length<3||!Array.isArray(center.hourly?.time)||center.hourly.time.length<12)return null;const suffixes=warningEnsembleMemberSuffixes(center);if(suffixes.length<2)return null;const times=center.hourly.time.map(String),now=Date.now(),maxEpoch=now+54*3600000,hours:WarningEnsembleModelHour[]=[];
 for(let index=0;index<times.length;index++){const time=times[index],epoch=localIsoEpoch(time,center.timezone,Number(center.utc_offset_seconds)||0);if(!Number.isFinite(epoch)||epoch<now-2*3600000||epoch>maxEpoch)continue;const centerGust:number[]=[],neighborhoodGust:number[]=[],centerPrecipitation:number[]=[],neighborhoodPrecipitation:number[]=[],centerTemperature:number[]=[],neighborhoodTemperatureLow:number[]=[],neighborhoodTemperatureHigh:number[]=[];
  for(const suffix of suffixes){const gustCenter=warningEnsembleValue(center,'wind_gusts_10m',suffix,index),precipCenter=warningEnsembleValue(center,'precipitation',suffix,index),tempCenter=warningEnsembleValue(center,'temperature_2m',suffix,index),gustValues=locations.map(location=>warningEnsembleValue(location,'wind_gusts_10m',suffix,index)).filter(Number.isFinite),precipValues=locations.map(location=>warningEnsembleValue(location,'precipitation',suffix,index)).filter(Number.isFinite),tempValues=locations.map(location=>warningEnsembleValue(location,'temperature_2m',suffix,index)).filter(Number.isFinite);if(Number.isFinite(gustCenter))centerGust.push(gustCenter);if(gustValues.length)neighborhoodGust.push(Math.max(...gustValues));if(Number.isFinite(precipCenter))centerPrecipitation.push(Math.max(0,precipCenter));if(precipValues.length)neighborhoodPrecipitation.push(Math.max(0,...precipValues));if(Number.isFinite(tempCenter))centerTemperature.push(tempCenter);if(tempValues.length){neighborhoodTemperatureLow.push(Math.min(...tempValues));neighborhoodTemperatureHigh.push(Math.max(...tempValues))}}
  if(centerGust.length||centerPrecipitation.length||centerTemperature.length)hours.push({time,epoch,centerGust,neighborhoodGust,centerPrecipitation,neighborhoodPrecipitation,centerTemperature,neighborhoodTemperatureLow,neighborhoodTemperatureHigh});
 }
 return hours.length?{model,hours}:null;
}
function aggregateWarningEnsembleModels(results:WarningEnsembleModelResult[],radiusKm:number):WarningEnsembleSupport|null{const allTimes=[...new Set(results.flatMap(result=>result.hours.map(hour=>hour.time)))].sort(),rows:WarningEnsembleSupportHour[]=[];for(const time of allTimes){const matching=results.map(result=>({result,hour:result.hours.find(hour=>hour.time===time)})).filter((entry):entry is {result:WarningEnsembleModelResult;hour:WarningEnsembleModelHour}=>Boolean(entry.hour));if(!matching.length)continue;const epoch=matching[0].hour.epoch,lead=Math.max(0,(epoch-Date.now())/86400000),gustCenter:{value:number;weight:number}[]=[],gustNeighborhood:{value:number;weight:number}[]=[],precipCenter:{value:number;weight:number}[]=[],precipNeighborhood:{value:number;weight:number}[]=[],tempCenter:{value:number;weight:number}[]=[],tempLow:{value:number;weight:number}[]=[],tempHigh:{value:number;weight:number}[]=[];let memberCount=0;const groups=new Set<string>();for(const {result,hour} of matching){const model=result.model;groups.add(model.independenceGroup);memberCount+=Math.max(hour.centerGust.length,hour.centerPrecipitation.length,hour.centerTemperature.length);const add=(source:number[],target:{value:number;weight:number}[],parameter:EnsembleWeightParameter)=>{if(!source.length)return;const weight=modelDayWeight(model,lead,source.length,parameter,1);for(const value of source)if(Number.isFinite(value))target.push({value,weight})};add(hour.centerGust,gustCenter,'wind');add(hour.neighborhoodGust,gustNeighborhood,'wind');add(hour.centerPrecipitation,precipCenter,'precipitation');add(hour.neighborhoodPrecipitation,precipNeighborhood,'precipitation');add(hour.centerTemperature,tempCenter,'temperature');add(hour.neighborhoodTemperatureLow,tempLow,'temperature');add(hour.neighborhoodTemperatureHigh,tempHigh,'temperature')}
 const q=(values:{value:number;weight:number}[],p:number)=>weightedQuantile(values,p);rows.push({time,epoch,gustP50:q(gustCenter,.5),gustP75:q(gustCenter,.75),gustP90:q(gustCenter,.9),gustNeighborhoodP75:q(gustNeighborhood,.75),gustNeighborhoodP90:q(gustNeighborhood,.9),precipitationP50:q(precipCenter,.5),precipitationP75:q(precipCenter,.75),precipitationP90:q(precipCenter,.9),precipitationNeighborhoodP75:q(precipNeighborhood,.75),precipitationNeighborhoodP90:q(precipNeighborhood,.9),temperatureP10:q(tempCenter,.1),temperatureP25:q(tempCenter,.25),temperatureP50:q(tempCenter,.5),temperatureP75:q(tempCenter,.75),temperatureP90:q(tempCenter,.9),temperatureNeighborhoodLowP10:q(tempLow,.1),temperatureNeighborhoodHighP90:q(tempHigh,.9),memberCount,modelFamilyCount:groups.size,spatialRadiusKm:radiusKm})}
 if(rows.length<8)return null;return{hours:rows,models:results.map(result=>result.model.label),radiusKm,pointCount:5};}
/**
 * Kurzfristige probabilistische Warnunterstützung. Pro Ensemblemitglied wird
 * zunächst der jeweils stärkste Wert im Standortpunkt plus vier Nachbarpunkten
 * bestimmt. Damit werden räumliche Verlagerungsfehler berücksichtigt, ohne die
 * Nachbarpunkte fälschlich als unabhängige Ensemblemitglieder zu zählen.
 */
export async function warningEnsembleNeighborhood(lat:number,lon:number,signal?:AbortSignal,forceRefresh=false):Promise<WarningEnsembleSupport|null>{const fresh=forceRefresh?null:readWarningEnsembleCache(lat,lon,WARNING_ENSEMBLE_FRESH_MS);if(fresh)return fresh;const stale=readWarningEnsembleCache(lat,lon),models=warningEnsembleModels(lat,lon);if(models.length<2)return stale;const radiusKm=12;try{const settled=await Promise.allSettled(models.map(model=>fetchWarningEnsembleModel(model,lat,lon,radiusKm,signal))),results=settled.filter((row):row is PromiseFulfilledResult<WarningEnsembleModelResult|null>=>row.status==='fulfilled').map(row=>row.value).filter(Boolean) as WarningEnsembleModelResult[];if(signal?.aborted)throw new DOMException('Abgebrochen','AbortError');if(results.length<2)return stale;const value=aggregateWarningEnsembleModels(results,radiusKm);if(value){writeWarningEnsembleCache(lat,lon,value);return value}return stale}catch(error){if(signal?.aborted)throw error;return stale}}


const CLIMATE_CACHE_PREFIX='mid:climatology:1991-2020:';
type ClimateCache={created:number;values:Record<string,{max:number;min:number;years:number}>};
function climateCacheKey(lat:number,lon:number,elevation?:number){return`${CLIMATE_CACHE_PREFIX}${(Math.round(lat*20)/20).toFixed(2)}:${(Math.round(lon*20)/20).toFixed(2)}:${Math.round(Number(elevation??0)/100)*100}`}
function climateFromCache(key:string,maxAgeMs=180*86400000){try{const raw=localStorage.getItem(key);if(!raw)return null;const parsed=JSON.parse(raw) as ClimateCache;if(!parsed?.values||Date.now()-Number(parsed.created)>maxAgeMs)return null;return parsed}catch{return null}}
function climateDateKey(date:string){return String(date).slice(5,10)}
export async function climatology(lat:number,lon:number,elevation:number|undefined,dates:string[],signal?:AbortSignal):Promise<ClimateDay[]>{
 const key=climateCacheKey(lat,lon,elevation),staleCache=climateFromCache(key,Number.POSITIVE_INFINITY);let cache=climateFromCache(key);
 if(!cache){
  try{
   const p=new URLSearchParams({latitude:String(lat),longitude:String(lon),start_date:'1991-01-01',end_date:'2020-12-31',daily:'temperature_2m_max,temperature_2m_min',timezone:'auto',models:'era5_land',cell_selection:'land'});if(Number.isFinite(elevation))p.set('elevation',String(elevation));
   const data=await j<any>(`https://archive-api.open-meteo.com/v1/archive?${p}`,signal),times=(data.daily?.time??[]) as string[],max=(data.daily?.temperature_2m_max??[]) as number[],min=(data.daily?.temperature_2m_min??[]) as number[],buckets=new Map<string,{max:number[];min:number[]}>();
   for(let i=0;i<times.length;i++){const k=climateDateKey(times[i]),hi=Number(max[i]),lo=Number(min[i]);if(!Number.isFinite(hi)||!Number.isFinite(lo))continue;const row=buckets.get(k)??{max:[],min:[]};row.max.push(hi);row.min.push(lo);buckets.set(k,row)}
   const values:ClimateCache['values']={};buckets.forEach((row,k)=>{if(row.max.length>=20&&row.min.length>=20)values[k]={max:row.max.reduce((a,b)=>a+b,0)/row.max.length,min:row.min.reduce((a,b)=>a+b,0)/row.min.length,years:Math.min(row.max.length,row.min.length)}});if(!values['02-29']&&values['02-28']&&values['03-01'])values['02-29']={max:(values['02-28'].max+values['03-01'].max)/2,min:(values['02-28'].min+values['03-01'].min)/2,years:Math.min(values['02-28'].years,values['03-01'].years)};cache={created:Date.now(),values};try{localStorage.setItem(key,JSON.stringify(cache))}catch{}
  }catch(error){if(staleCache)cache=staleCache;else throw error}
 }
 return dates.map(date=>{const v=cache!.values[climateDateKey(date)];return v?{date,maxMean:v.max,minMean:v.min,years:v.years}:null}).filter(Boolean) as ClimateDay[];
}

export function label(c:number){const m:Record<number,string>={0:'Klar',1:'Überwiegend klar',2:'Teilweise bewölkt',3:'Bedeckt',45:'Nebel',48:'Reifnebel',51:'Leichter Sprühregen',53:'Sprühregen',55:'Starker Sprühregen',56:'Leichter gefrierender Sprühregen',57:'Starker gefrierender Sprühregen',61:'Leichter Regen',63:'Regen',65:'Starker Regen',66:'Leichter gefrierender Regen',67:'Starker gefrierender Regen',68:'Leichter Schneeregen',69:'Schneeregen',71:'Leichter Schneefall',73:'Schneefall',75:'Starker Schneefall',77:'Schneegriesel',80:'Leichte Regenschauer',81:'Regenschauer',82:'Starke Regenschauer',83:'Leichte Schneeregenschauer',84:'Schneeregenschauer',85:'Leichte Schneeschauer',86:'Starke Schneeschauer',95:'Gewitter',96:'Gewitter mit Hagel',97:'Starkes Gewitter',99:'Starkes Gewitter mit Hagel'};return m[c]??'Wechselhaft'}
export function wind(v:number,u:WindUnit){if(!Number.isFinite(v))return'–';if(u==='kmh')return`${Math.round(v*1.852)} km/h`;if(u==='ms')return`${formatDecimal(v*.514444,1,1)} m/s`;if(u==='mph')return`${Math.round(v*1.15078)} mph`;return`${Math.round(v)} kt`}

export type HazardLevel='yellow'|'orange'|'red'|'purple';
export type HazardItem={level:HazardLevel;title:string;text:string;metric?:string;displayMetric?:string;displayText?:string;scopeLabel?:string;precisionLabel?:string;validFrom?:string;validTo?:string;kind?:DwdWarningKind;lowerIntensity?:boolean;conditional?:boolean;stageRank?:number;thresholdValue?:number;windowHours?:number};

type HazardWindowSummary={displayMetric:string;displayText:string;scopeLabel:string;precisionLabel:string;conditional:boolean;validFrom?:string;validTo?:string};
const levelOrder:{[k in HazardLevel]:number}={purple:4,red:3,orange:2,yellow:1};
function dwdHazardClass(level:DwdWarningLevel):HazardLevel{return level===4?'purple':level===3?'red':level===2?'orange':'yellow'}
function hazardSignalHours(signal:DwdWarningSignal,hours:Hour[]){const start=Date.parse(String(signal.validFrom??'')),end=Date.parse(String(signal.validTo??''));if(!Number.isFinite(start)||!Number.isFinite(end))return[] as Hour[];return hours.filter(hour=>Number.isFinite(Number(hour.epoch))&&Number(hour.epoch)<end&&Number(hour.epoch)+3600000>start)}
function hazardConvectiveContext(signal:DwdWarningSignal,hours:Hour[]){if(signal.kind==='thunderstorm')return true;if(signal.kind!=='wind'&&signal.kind!=='heavyRain')return false;const relevant=hazardSignalHours(signal,hours);if(!relevant.length)return false;return relevant.some(hour=>Math.max(0,Number(hour.showers)||0)>=.05||[80,81,82,83,84,85,86,95,96,97,99].includes(Math.round(Number(hour.code))))}
function hazardBand(value:number,step:number){const finiteValue=Number(value);if(!Number.isFinite(finiteValue))return null;let lower=Math.floor(finiteValue/step)*step,upper=Math.ceil(finiteValue/step)*step;if(Math.abs(upper-lower)<1e-9){lower-=step/2;upper+=step/2}return{lower,upper}}
function hazardAmountBand(value:number,kind:DwdWarningKind,windowHours?:number){const number=Number(value);if(!Number.isFinite(number))return'';if(kind==='fog')return'Sicht unter 200 m';if(kind==='heat'){const band=hazardBand(number,2);return band?`bis zu ${Math.round(band.upper)} °C`:''}if(kind==='frost'){const band=hazardBand(number,2);return band?`örtlich bis ${Math.round(band.lower)} °C`:''}if(kind==='heavyRain'||kind==='continuousRain'){const step=number<20?2:number<60?5:10,spread=Math.max(step,number<20?4:number<60?8:12),band=hazardBand(number,step);if(!band)return'';return`bis zu ${Math.max(0,Math.round(band.upper+spread/2))} mm${windowHours?`/${windowHours} h`:''}`}if(kind==='snow'){const step=number<10?2:5,spread=number<10?2:4,band=hazardBand(number,step);if(!band)return'';return`bis zu ${Math.max(0,Math.round(band.upper+spread/2))} cm${windowHours?`/${windowHours} h`:''}`}return''}
function hazardWindowPaddingHours(kind:DwdWarningKind,conditional:boolean){if(kind==='wind')return conditional?3:2;if(kind==='thunderstorm'||kind==='heavyRain'||kind==='snowdrift')return 2;if(kind==='continuousRain'||kind==='snow')return 3;if(kind==='fog'||kind==='ice')return 2;if(kind==='heat'||kind==='frost')return 3;return conditional?2:1}
function hazardThresholdKmh(signal:DwdWarningSignal){const threshold=Number(signal.thresholdValue);if(Number.isFinite(threshold))return threshold;const value=Number(signal.value);if(Number.isFinite(value))return Math.max(0,value-10);return 0}
function warningEnsembleHourForEpoch(ensemble:WarningEnsembleSupport|undefined|null,epoch:number){if(!ensemble?.hours?.length||!Number.isFinite(epoch))return null;let best:WarningEnsembleSupportHour|null=null,bestDelta=Infinity;for(const row of ensemble.hours){const delta=Math.abs(Number(row.epoch)-epoch);if(delta<bestDelta){best=row;bestDelta=delta}}return bestDelta<=45*60000?best:null}
function warningEnsembleWindowSum(ensemble:WarningEnsembleSupport|undefined|null,epoch:number,windowHours:number,key:'precipitationP75'|'precipitationP90'|'precipitationNeighborhoodP75'|'precipitationNeighborhoodP90'){let total=0,coverage=0;for(let offset=0;offset<windowHours;offset++){const row=warningEnsembleHourForEpoch(ensemble,epoch+offset*3600000),value=Number(row?.[key]);if(Number.isFinite(value)){total+=Math.max(0,value);coverage++}}return coverage>=Math.max(1,Math.ceil(windowHours*.6))?total:NaN}
function hazardSupportScore(signal:DwdWarningSignal,hours:Hour[],index:number,conditional:boolean,ensemble?:WarningEnsembleSupport|null){const hour=hours[index],epoch=Number(hour.epoch),ensembleHour=warningEnsembleHourForEpoch(ensemble,epoch),code=Math.round(Number(hour.code)||0),gustKmh=(Number(hour.gust)||0)*1.852,precip=Math.max(0,Number(hour.precipitation)||0),snowfall=Math.max(0,Number(hour.snowfall)||0),showers=Math.max(0,Number(hour.showers)||0),visibility=Number(hour.visibility),temp=Number(hour.temperature),threshold=Number(signal.thresholdValue);const above=(value:number,base:number,margin:number)=>{if(!Number.isFinite(value)||!Number.isFinite(base))return 0;return Math.max(0,Math.min(1,(value-(base-margin))/Math.max(1,margin*2)))};const below=(value:number,base:number,margin:number)=>{if(!Number.isFinite(value)||!Number.isFinite(base))return 0;return Math.max(0,Math.min(1,((base+margin)-value)/Math.max(1,margin*2)))};const sumForward=(key:'precipitation'|'snowfall',windowHours:number)=>{let total=0;for(let offset=0;offset<windowHours;offset++){const sample=hours[index+offset];if(!sample)break;total+=Math.max(0,Number(sample[key])||0)}return total};const epsAbove=(center75:number,center90:number,near75:number,near90:number,base:number,margin:number,convert=1)=>Math.max(above(center75*convert,base,margin)*.9,above(center90*convert,base,margin*1.25)*.68,above(near75*convert,base,margin*1.35)*.62,above(near90*convert,base,margin*1.5)*.48);const epsBelow=(center25:number,center10:number,near10:number,base:number,margin:number)=>Math.max(below(center25,base,margin)*.85,below(center10,base,margin*1.2)*.65,below(near10,base,margin*1.35)*.5);
 if(signal.kind==='wind'){const base=above(gustKmh,hazardThresholdKmh(signal),conditional?14:10),eps=ensembleHour?epsAbove(Number(ensembleHour.gustP75),Number(ensembleHour.gustP90),Number(ensembleHour.gustNeighborhoodP75),Number(ensembleHour.gustNeighborhoodP90),hazardThresholdKmh(signal),conditional?14:10,1.852):0;return Math.max(base,eps)}
 if(signal.kind==='thunderstorm'){const lightning=[95,96,97,99].includes(code)?1:0,convective=showers>=.3||precip>=1.5?0.55:0,strongWind=gustKmh>=55?0.4:0,eps=ensembleHour?Math.max(above(Number(ensembleHour.precipitationNeighborhoodP90),1.5,1)*.42,above(Number(ensembleHour.gustNeighborhoodP90)*1.852,55,15)*.34):0;return Math.max(lightning,convective,strongWind,eps)}
 if(signal.kind==='heavyRain'){const windowHours=Math.max(1,Number(signal.windowHours)||1),baseThreshold=Number.isFinite(threshold)?threshold:Number(signal.value)*.8,margin=Math.max(2,Number(signal.value)*.25),base=above(sumForward('precipitation',windowHours),baseThreshold,margin),eps75=warningEnsembleWindowSum(ensemble,epoch,windowHours,'precipitationP75'),eps90=warningEnsembleWindowSum(ensemble,epoch,windowHours,'precipitationP90'),near75=warningEnsembleWindowSum(ensemble,epoch,windowHours,'precipitationNeighborhoodP75'),near90=warningEnsembleWindowSum(ensemble,epoch,windowHours,'precipitationNeighborhoodP90');return Math.max(base,above(eps75,baseThreshold,margin)*.85,above(eps90,baseThreshold,margin*1.2)*.66,above(near75,baseThreshold,margin*1.35)*.58,above(near90,baseThreshold,margin*1.5)*.44)}
 if(signal.kind==='continuousRain'){const windowHours=Math.max(3,Number(signal.windowHours)||6),baseThreshold=Number.isFinite(threshold)?threshold:Number(signal.value)*.8,margin=Math.max(3,Number(signal.value)*.2),base=above(sumForward('precipitation',windowHours),baseThreshold,margin),eps75=warningEnsembleWindowSum(ensemble,epoch,windowHours,'precipitationP75'),near90=warningEnsembleWindowSum(ensemble,epoch,windowHours,'precipitationNeighborhoodP90');return Math.max(base,above(eps75,baseThreshold,margin)*.78,above(near90,baseThreshold,margin*1.4)*.4)}
 if(signal.kind==='snow'){const base=above(sumForward('snowfall',Math.max(1,Number(signal.windowHours)||6)),Number.isFinite(threshold)?threshold:Number(signal.value)*.8,Math.max(1,Number(signal.value)*.25)),eps=ensembleHour&&Number(ensembleHour.temperatureP25)<=1.5?above(Number(ensembleHour.precipitationP75),.5,.5)*.35:0,near=ensembleHour&&Number(ensembleHour.temperatureNeighborhoodLowP10)<=1.5?above(Number(ensembleHour.precipitationNeighborhoodP90),.5,.7)*.25:0;return Math.max(base,eps,near)}
 if(signal.kind==='snowdrift'){const snowScore=above(sumForward('snowfall',Math.max(1,Number(signal.windowHours)||6)),Math.max(1,Number(signal.secondaryValue)||1),Math.max(1,Number(signal.secondaryValue)||2)),windScore=above(gustKmh,hazardThresholdKmh(signal),12),epsWind=ensembleHour?epsAbove(Number(ensembleHour.gustP75),Number(ensembleHour.gustP90),Number(ensembleHour.gustNeighborhoodP75),Number(ensembleHour.gustNeighborhoodP90),hazardThresholdKmh(signal),12,1.852):0;return Math.max(snowScore*.85,windScore,epsWind*.75)}
 if(signal.kind==='fog')return below(visibility,Number.isFinite(threshold)?threshold:200,200);
 if(signal.kind==='ice'){const freezing=below(temp,.5,1.5),wet=precip>=.1||snowfall>=.1||[56,57,66,67].includes(code)?1:.35,eps=ensembleHour?epsBelow(Number(ensembleHour.temperatureP25),Number(ensembleHour.temperatureP10),Number(ensembleHour.temperatureNeighborhoodLowP10),.5,1.5)*Math.max(.3,above(Number(ensembleHour.precipitationNeighborhoodP90),.1,.2)):0;return Math.max(Math.min(1,Math.max(freezing,below(temp,-.5,1))*wet),eps)}
 if(signal.kind==='heat'){const base=Number.isFinite(threshold)?threshold:Number(signal.value)-1;return Math.max(above(temp,base,2.5),ensembleHour?Math.max(above(Number(ensembleHour.temperatureP75),base,2.5)*.85,above(Number(ensembleHour.temperatureNeighborhoodHighP90),base,3)*.5):0)}
 if(signal.kind==='frost'){const base=Number.isFinite(threshold)?threshold:Number(signal.value)+1;return Math.max(below(temp,base,2),ensembleHour?epsBelow(Number(ensembleHour.temperatureP25),Number(ensembleHour.temperatureP10),Number(ensembleHour.temperatureNeighborhoodLowP10),base,2):0)}
 return 0}
function hazardProbabilisticWindow(signal:DwdWarningSignal,hours:Hour[],conditional:boolean,ensemble?:WarningEnsembleSupport|null){const start=Date.parse(String(signal.validFrom??'')),end=Date.parse(String(signal.validTo??''));if(!Number.isFinite(start)||!Number.isFinite(end))return{validFrom:signal.validFrom,validTo:signal.validTo};const basePadHours=hazardWindowPaddingHours(signal.kind,conditional),epsPadHours=ensemble?.hours?.length?(signal.kind==='wind'?4:signal.kind==='thunderstorm'||signal.kind==='heavyRain'||signal.kind==='snowdrift'?3:basePadHours):basePadHours,padMs=Math.max(basePadHours,epsPadHours)*3600000;const scored=hours.map((hour,index)=>({epoch:Number(hour.epoch),score:hazardSupportScore(signal,hours,index,conditional,ensemble)})).filter(row=>Number.isFinite(row.epoch)&&row.epoch+3600000>start-padMs&&row.epoch<end+padMs);if(!scored.length)return{validFrom:signal.validFrom,validTo:signal.validTo};const support=scored.filter(row=>row.score>=.2),core=scored.filter(row=>row.score>=.45),first=support[0]??core[0],last=support.at(-1)??core.at(-1);if(!first||!last)return{validFrom:signal.validFrom,validTo:signal.validTo};const from=new Date(Math.min(start,first.epoch)).toISOString(),to=new Date(Math.max(end,last.epoch+3600000)).toISOString();return{validFrom:from,validTo:to}}
function hazardWindUpTo(kmh:number,unit:WindUnit,maximumExclusiveKmh=Number.NaN){
 if(!Number.isFinite(kmh))return'';
 const rounded=(value:number,step:number,maximumExclusive=Number.NaN)=>{let result=Math.max(0,Math.ceil(value/step)*step);if(Number.isFinite(maximumExclusive)){const cap=Math.max(0,Math.floor((maximumExclusive-1e-6)/step)*step);result=Math.min(result,cap)}return result};
 if(unit==='kmh')return`bis zu ${rounded(kmh,5,maximumExclusiveKmh)} km/h`;
 if(unit==='ms')return`bis zu ${rounded(kmh/3.6,2,Number.isFinite(maximumExclusiveKmh)?maximumExclusiveKmh/3.6:Number.NaN)} m/s`;
 if(unit==='mph')return`bis zu ${rounded(kmh/1.609344,5,Number.isFinite(maximumExclusiveKmh)?maximumExclusiveKmh/1.609344:Number.NaN)} mph`;
 return`bis zu ${rounded(kmh/1.852,5,Number.isFinite(maximumExclusiveKmh)?maximumExclusiveKmh/1.852:Number.NaN)} kt`;
}
function hazardWindUpperKmh(signal:DwdWarningSignal,ensemble:WarningEnsembleSupport|undefined|null,conditional:boolean){const start=Date.parse(String(signal.validFrom??'')),end=Date.parse(String(signal.validTo??'')),candidates=(ensemble?.hours??[]).filter(row=>!Number.isFinite(start)||!Number.isFinite(end)||(row.epoch>=start-3*3600000&&row.epoch<=end+3*3600000)).flatMap(row=>[Number(row.gustP90)*1.852,Number(row.gustNeighborhoodP90)*1.852]).filter(Number.isFinite),base=Number(signal.value),fallback=Number.isFinite(base)?base+(conditional?8:5):NaN,maxCandidate=candidates.length?Math.max(...candidates):NaN,cap=Number.isFinite(base)?Math.max(base+12,base*1.3):maxCandidate;return Number.isFinite(maxCandidate)?Math.min(maxCandidate,cap):fallback}
function hazardStageRank(signal:DwdWarningSignal){return Number(signal.stageRank)||signal.level}
function hazardNextWindThresholdKmh(signal:DwdWarningSignal){if(signal.kind!=='wind'||!signal.lowerIntensity)return Number.NaN;const rank=hazardStageRank(signal),next=DWD_WIND_THRESHOLDS_KMH[rank];return Number(next?.threshold)}
function hazardPresentation(signal:DwdWarningSignal,hours:Hour[],unit:WindUnit,ensemble?:WarningEnsembleSupport|null):HazardWindowSummary{const conditional=hazardConvectiveContext(signal,hours),window=hazardProbabilisticWindow(signal,hours,conditional,ensemble),direction=formatDwdWarningDirection(signal),directionInline=direction?`${direction.charAt(0).toLocaleLowerCase('de-DE')}${direction.slice(1)}`:'',nextWindThreshold=hazardNextWindThresholdKmh(signal),windUpper=signal.kind==='wind'||signal.kind==='snowdrift'?hazardWindUpTo(hazardWindUpperKmh(signal,ensemble,conditional),unit,nextWindThreshold):'',amountBand=hazardAmountBand(Number(signal.value),signal.kind,signal.windowHours),displayMetric=signal.kind==='wind'?windUpper:signal.kind==='snowdrift'?[hazardAmountBand(Number(signal.secondaryValue),'snow',signal.windowHours),windUpper&&`${windUpper} Böen`].filter(Boolean).join(' · '):amountBand,scopeLabel=conditional?'lokal':signal.kind==='fog'||signal.kind==='ice'?'kleinräumig':signal.kind==='heavyRain'?'lokal bis gebietsweise':signal.kind==='continuousRain'||signal.kind==='snow'||signal.kind==='snowdrift'?'gebietsweise':signal.kind==='heat'||signal.kind==='frost'?'regional':'lokal',precisionLabel='Wahrscheinlichkeitsbereich',ensembleNote=ensemble?.hours?.length?' Ensemble-Läufe und die räumliche Umfeldprüfung stützen dabei auch zeitlich versetzte Treffer.':'';let displayText='';if(signal.kind==='wind'){const prefix=signal.lowerIntensity?'Im verbleibenden Prognosefenster':'Im Prognosefenster';displayText=conditional?`${prefix} sind lokal Böen ${windUpper||formatDwdWarningValue(signal,unit)} möglich${directionInline?` ${directionInline}`:''}.${ensembleNote} Konvektive Verstärkungen können einzelne Spitzen darüber auslösen.`:`${prefix} sind Böen ${windUpper||formatDwdWarningValue(signal,unit)} möglich${directionInline?` ${directionInline}`:''}.${ensembleNote} Der genaue Zeitpunkt einzelner Spitzen bleibt unsicher.`}else if(signal.kind==='thunderstorm')displayText=`Im Prognosefenster sind örtlich Gewitter möglich.${ensembleNote} Die genaue Zugbahn einzelner Zellen kann den Standort treffen, streifen oder verfehlen.`;else if(signal.kind==='heavyRain')displayText=`Im Prognosefenster sind ${displayMetric||formatDwdWarningValue(signal,unit)} möglich.${ensembleNote} Niederschlagskerne können kleinräumig variieren; deshalb wird kein punktgenauer Eintritt suggeriert.`;else if(signal.kind==='continuousRain')displayText=`Im Prognosefenster sind ${displayMetric||formatDwdWarningValue(signal,unit)} möglich.${ensembleNote} Zugbahn und Staueffekte können die tatsächlichen Summen lokal verschieben.`;else if(signal.kind==='snow')displayText=`Im Prognosefenster sind ${displayMetric||formatDwdWarningValue(signal,unit)} Neuschnee möglich.${ensembleNote} Temperatur, Untergrund und kleinräumige Unterschiede können die tatsächliche Höhe verändern.`;else if(signal.kind==='snowdrift')displayText=`Im Prognosefenster sind Schneeverwehungen gebietsweise möglich.${ensembleNote} Schneemenge und Böen werden probabilistisch bewertet.`;else if(signal.kind==='fog')displayText='Im Prognosefenster kann die Sicht kleinräumig unter etwa 200 m sinken. Nebelgrenzen und Sichtweiten können sich auf kurzer Distanz deutlich unterscheiden.';else if(signal.kind==='ice')displayText=`Im Prognosefenster kann Glätte beziehungsweise Glatteis punktuell auftreten.${ensembleNote} Untergrund und Niederschlagsphase können kleinräumig abweichen.`;else if(signal.kind==='heat')displayText=`Im Prognosefenster ist eine Wärmebelastung im Bereich ${displayMetric||formatDwdWarningValue(signal,unit)} möglich.${ensembleNote} Exposition und nächtliche Abkühlung beeinflussen die tatsächliche Belastung.`;else if(signal.kind==='frost')displayText=`Im Prognosefenster sind Temperaturen im Bereich ${displayMetric||formatDwdWarningValue(signal,unit)} möglich.${ensembleNote} Bodennahe Werte und geschützte Lagen können stärker abweichen.`;else displayText=signal.detail;return{displayMetric,displayText,scopeLabel,precisionLabel,conditional,validFrom:window.validFrom,validTo:window.validTo}}
function trimLowerHazardBoundary(signal:DwdWarningSignal,presentation:HazardWindowSummary,rows:{signal:DwdWarningSignal;presentation:HazardWindowSummary}[]){
 if(!signal.lowerIntensity)return presentation;
 let from=Date.parse(String(presentation.validFrom??signal.validFrom??'')),to=Date.parse(String(presentation.validTo??signal.validTo??''));if(!Number.isFinite(from)||!Number.isFinite(to)||to<=from)return presentation;
 const higher=rows.filter(row=>row.signal!==signal&&row.signal.kind===signal.kind&&hazardStageRank(row.signal)>hazardStageRank(signal)).map(row=>({start:Date.parse(String(row.presentation.validFrom??row.signal.validFrom??'')),end:Date.parse(String(row.presentation.validTo??row.signal.validTo??''))})).filter(row=>Number.isFinite(row.start)&&Number.isFinite(row.end)&&row.end>from&&row.start<to).sort((a,b)=>a.start-b.start);
 let moved=true;while(moved){moved=false;for(const row of higher)if(row.start<=from+5*60000&&row.end>from){from=Math.max(from,row.end);moved=true}}
 moved=true;while(moved){moved=false;for(const row of [...higher].reverse())if(row.start<to&&row.end>=to-5*60000){to=Math.min(to,row.start);moved=true}}
 if(to<=from)return{...presentation,validFrom:undefined,validTo:undefined};return{...presentation,validFrom:new Date(from).toISOString(),validTo:new Date(to).toISOString()};
}

export function hazards(h:Hour[],_currentUv?:number,elevation=0,unit:WindUnit='kn',ensemble?:WarningEnsembleSupport|null){
 const start=warningCurrentStartIndex(h),horizon=h.slice(start,start+96);if(!horizon.length)return[] as HazardItem[];
 const signals=summarizeDwdWarnings(horizon,elevation,24),rows=signals.map(signal=>({signal,presentation:hazardPresentation(signal,horizon,unit,ensemble)}));
 return rows.map(row=>({row,presentation:trimLowerHazardBoundary(row.signal,row.presentation,rows)})).filter(({row,presentation})=>!row.signal.lowerIntensity||Boolean(presentation.validFrom&&presentation.validTo)).map(({row,presentation})=>{const signal=row.signal;return{level:dwdHazardClass(signal.level),title:signal.title,metric:formatDwdWarningValue(signal,unit),text:formatDwdWarningDetailWithDirection(signal,unit),...presentation,validFrom:presentation.validFrom??signal.validFrom,validTo:presentation.validTo??signal.validTo,kind:signal.kind,lowerIntensity:signal.lowerIntensity,stageRank:signal.stageRank,thresholdValue:signal.thresholdValue,windowHours:signal.windowHours}}).sort((a,b)=>levelOrder[b.level]-levelOrder[a.level]);
}
