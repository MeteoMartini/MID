   const modelSunshine=rows.map(item=>item.sunshineDuration).filter((value):value is number=>value!==null&&Number.isFinite(value));modelSummaries.push({id:r.model.id,label:r.model.label,family:r.model.family,independenceGroup:r.model.independenceGroup,max:quantile(rows.map(item=>item.max),.5),min:quantile(rows.map(item=>item.min),.5),precipitation:quantile(rows.map(item=>item.precipitation),.5),precipitationProbability:100*rows.filter(item=>item.precipitation>DWD_PRECIPITATION_PROBABILITY_THRESHOLD_MM).length/Math.max(1,rows.length),precipitationProbabilitySignificant:100*rows.filter(item=>item.precipitation>DWD_SIGNIFICANT_PRECIPITATION_PROBABILITY_THRESHOLD_MM).length/Math.max(1,rows.length),probabilityQuality,memberCount:native?rows.length:0,wind:rows.some(item=>Number.isFinite(item.wind))?quantile(rows.map(item=>item.wind).filter(Number.isFinite),.5):undefined,gust:rows.some(item=>Number.isFinite(item.gust))?quantile(rows.map(item=>item.gust).filter(Number.isFinite),.5):undefined,sunshineDuration:modelSunshine.length?quantile(modelSunshine,.5):null});
   for(const row of rows){maxVals.push({value:row.max,weight:tempWeight});minVals.push({value:row.min,weight:tempWeight});rainVals.push({value:row.precipitation,weight:precipWeight});(native?nativeRainProbabilityVals:estimatedRainProbabilityVals).push({value:row.precipitation,weight:precipWeight});if(native)row.precipitationWindows.forEach((value,index)=>{if(Number.isFinite(value))windowRainProbabilityVals[index].push({value,weight:precipWeight})});if(row.sunshineDuration!==null&&Number.isFinite(row.sunshineDuration))sunVals.push({value:row.sunshineDuration,weight:generalWeight});if(Number.isFinite(row.wind))windVals.push({value:row.wind,weight:windWeight});if(Number.isFinite(row.gust))gustVals.push({value:row.gust,weight:windWeight})}
