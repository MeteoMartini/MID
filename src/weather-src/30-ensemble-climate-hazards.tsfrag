const ENSEMBLE_DIRECT_ATTEMPT_TIMEOUT_MS=12_000;
const ENSEMBLE_MODEL_TIMEOUT_MS=20_000;
const ENSEMBLE_BOOTSTRAP_TIMEOUT_MS=30_000;
function ensembleRetryDelay(ms:number,signal?:AbortSignal){return new Promise<void>((resolve,reject)=>{if(signal?.aborted){reject(signal.reason instanceof Error?signal.reason:new DOMException('Abgebrochen','AbortError'));return}let done=false;const finish=(callback:()=>void)=>{if(done)return;done=true;signal?.removeEventListener('abort',onAbort);callback()},timer=setTimeout(()=>finish(resolve),ms),onAbort=()=>{clearTimeout(timer);finish(()=>reject(signal?.reason instanceof Error?signal.reason:new DOMException('Abgebrochen','AbortError')))};signal?.addEventListener('abort',onAbort,{once:true})})}
function ensembleDeadline(parent:AbortSignal|undefined,timeoutMs:number,message:string){const controller=new AbortController();let timedOut=false;const parentAbort=()=>controller.abort(parent?.reason instanceof Error?parent.reason:new DOMException('Abgebrochen','AbortError')),timer=setTimeout(()=>{timedOut=true;controller.abort(new DOMException(message,'TimeoutError'))},timeoutMs);if(parent?.aborted)parentAbort();else parent?.addEventListener('abort',parentAbort,{once:true});return{signal:controller.signal,timedOut:()=>timedOut,cleanup:()=>{clearTimeout(timer);parent?.removeEventListener('abort',parentAbort)}}}
async function ensembleJsonAttempt(url:string,signal:AbortSignal|undefined,priority:OpenMeteoPriority,maxRetries:number,dedupe=true){const deadline=ensembleDeadline(signal,ENSEMBLE_DIRECT_ATTEMPT_TIMEOUT_MS,'Zeitüberschreitung beim direkten Ensemble-Abruf.');try{return await guardedOpenMeteoJson<Weather>(url,{signal:deadline.signal,cache:'no-store'},{priority,maxRetries,dedupe})}finally{deadline.cleanup()}}
async function fetchEnsembleRequest(url:string,signal?:AbortSignal,priority:OpenMeteoPriority='normal'){
 try{return await ensembleJsonAttempt(url,signal,priority,0)}
 catch(error){if(signal?.aborted||priority==='background'||isOpenMeteoRateLimitError(error))throw error;await ensembleRetryDelay(450,signal);return ensembleJsonAttempt(url,signal,priority,0,false)}
}
function ensembleVariableFallbackEligible(error:unknown){const message=String(error instanceof Error?error.message:error||'').toLocaleLowerCase('en');return /variable|hourly|unsupported|not available|not supported|invalid parameter|sunshine|wind_gust|wind_speed/.test(message)}
const AIFS_EUROPE_AUDIT_FIELDS=['cloud_cover','cloud_cover_low','cloud_cover_mid','cloud_cover_high'] as const;
function ensembleVariablesForContract(modelId:string,variables:string){if(modelId!=='ecmwf_aifs_europe_ensemble')return variables;const rows=variables.split(',').map(value=>value.trim()).filter(Boolean);for(const field of AIFS_EUROPE_AUDIT_FIELDS)if(!rows.includes(field))rows.push(field);return rows.join(',')}
function ensembleFieldValues(weather:Weather,field:string){const pattern=new RegExp(`^${field}(?:_member[0-9]+)?$`);return Object.entries(weather.hourly??{}).filter(([key])=>pattern.test(key)).flatMap(([,values])=>Array.isArray(values)?values.map(n).filter(Number.isFinite):[])}
export function aifsEuropeEnsembleContractValid(weather:Weather){const precipitation=ensembleFieldValues(weather,'precipitation');if(precipitation.length<12||precipitation.some(value=>value<0||value>500))return false;for(const field of AIFS_EUROPE_AUDIT_FIELDS){const values=ensembleFieldValues(weather,field);if(values.length<12||values.some(value=>value<0||value>100))return false}return true}
async function fetchEnsembleWeather(lat:number,lon:number,forecastDays:number,modelId:string,signal?:AbortSignal,hourly='temperature_2m,precipitation,wind_speed_10m,wind_gusts_10m,sunshine_duration',priority:OpenMeteoPriority='normal'){
 const modelDeadline=ensembleDeadline(signal,priority==='background'?34_000:ENSEMBLE_MODEL_TIMEOUT_MS,`${modelId}: Ensemble-Modellabruf hat das Zeitbudget überschritten.`),modelSignal=modelDeadline.signal;
 try{
  const forecast_days=Math.max(1,Math.min(14,Math.ceil(forecastDays))),request=async(rawVariables:string)=>{
   const variables=ensembleVariablesForContract(modelId,rawVariables),parameters={lat,lon,model:modelId,forecast_days,variables},directRegional=DIRECT_REGIONAL_ENSEMBLE_MODELS.has(modelId);let proxyError:unknown;
   if(workerBaseCandidates('general').length){try{const proxied=await fetchWorkerJson<Weather&{error?:string}>('ensemble-proxy',parameters,{purpose:'general',signal:modelSignal,timeoutMs:priority==='foreground'?10_000:16_000,cache:'no-store'});if(Array.isArray(proxied?.hourly?.time)&&proxied.hourly.time.length>=12){if(modelId==='ecmwf_aifs_europe_ensemble'&&!aifsEuropeEnsembleContractValid(proxied))throw new Error('ECMWF AIFS Europa Ensemble: Bewölkungs-/Niederschlagswerte außerhalb des Open-Meteo-Vertrags');return proxied;}proxyError=new Error(`${modelId}: Regionalensemble-Adapter lieferte keine nutzbare Zeitreihe`)}catch(error){proxyError=error}}
   if(modelSignal.aborted)throw modelSignal.reason instanceof Error?modelSignal.reason:new DOMException('Abgebrochen','AbortError');
   if(directRegional)throw proxyError instanceof Error?proxyError:new Error(`${modelId}: numerischer Regionalensemble-Adapter nicht verfügbar`);
   const p=new URLSearchParams({latitude:String(lat),longitude:String(lon),timezone:'auto',forecast_days:String(forecast_days),models:modelId,hourly:variables,wind_speed_unit:'kn'}),weather=await fetchEnsembleRequest(`https://ensemble-api.open-meteo.com/v1/ensemble?${p}`,modelSignal,priority);if(modelId==='ecmwf_aifs_europe_ensemble'&&!aifsEuropeEnsembleContractValid(weather))throw new Error('ECMWF AIFS Europa Ensemble: Bewölkungs-/Niederschlagswerte außerhalb des Open-Meteo-Vertrags');return weather
  };
  const attempts=[hourly,hourly.split(',').filter(value=>value!=='sunshine_duration').join(','),'temperature_2m,precipitation,wind_speed_10m,wind_gusts_10m','temperature_2m,precipitation'].filter((value,index,list)=>value&&list.indexOf(value)===index);let lastError:unknown;for(let index=0;index<attempts.length;index++){try{return await request(attempts[index])}catch(error){lastError=error;if(modelSignal.aborted)throw error;if(index<attempts.length-1&&!ensembleVariableFallbackEligible(error))throw error}}throw lastError;
 }catch(error){if(signal?.aborted)throw error;if(modelDeadline.timedOut())throw new Error(`${modelId}: Ensemble-Modellabruf nach ${Math.round((priority==='background'?34_000:ENSEMBLE_MODEL_TIMEOUT_MS)/1000)} s abgebrochen; nächstes unabhängiges Modell wird versucht.`);throw error}finally{modelDeadline.cleanup()}
}
function pseudoModelFromMeanSpread(w:Weather,definition:EnsembleMeanModel):ModelResult|null{
 const times=(w.hourly?.time as string[])??[],mean=w.hourly?.temperature_2m??[],spread=w.hourly?.temperature_2m_spread??[],rain=w.hourly?.precipitation??[],rainSpread=w.hourly?.precipitation_spread??[];
 if(times.length<24||!mean.length||!spread.length)return null;
 const z=[-1.28155,-.67449,0,.67449,1.28155],members=new Map<string,MemberDay[]>();
 for(let member=0;member<z.length;member++){
  const daily=new Map<string,{t:number[];p:number[];pb:[number[],number[],number[],number[]]}>();
  for(let index=0;index<times.length;index++){
   const timestamp=String(times[index]),date=timestamp.slice(0,10),hour=Number(timestamp.slice(11,13)),temperature=n(mean[index]),sigma=Math.max(0,n(spread[index])),precipitation=Math.max(0,n(rain[index])+z[member]*Math.max(0,n(rainSpread[index])));
   if(!Number.isFinite(temperature))continue;const row=daily.get(date)??{t:[],p:[],pb:[[],[],[],[]]};row.t.push(temperature+z[member]*sigma);if(Number.isFinite(precipitation)){row.p.push(precipitation);if(Number.isFinite(hour)&&hour>=0&&hour<24)row.pb[Math.min(3,Math.floor(hour/6))].push(precipitation)}daily.set(date,row);
  }
  const rows:MemberDay[]=[];daily.forEach((row,date)=>{if(row.t.length>=18){const precipitationWindows=row.pb.map(values=>values.length>=5?values.reduce((sum,value)=>sum+value,0):NaN) as [number,number,number,number];rows.push({date,max:Math.max(...row.t),min:Math.min(...row.t),precipitation:row.p.reduce((sum,value)=>sum+value,0),precipitationWindows,sunshineDuration:null,wind:NaN,gust:NaN})}});
  if(rows.length>=5)members.set(`spread_${member+1}`,rows);
 }
 if(members.size<3)return null;
 const model:EnsembleModel={id:definition.id,label:definition.label,metaId:definition.metaId,family:definition.family,independenceGroup:definition.independenceGroup,resolutionKm:definition.resolutionKm,updateHours:definition.updateHours,maxDays:definition.maxDays,distributionMode:'mean-spread'};
 return{model,members};
}
export type EnsembleForecastBundle={days:EnsembleDay[];models:string[];runs:ModelRunMeta[];scenarios:EnsembleScenarioCluster[];bootstrap?:boolean};
const ENSEMBLE_BOOTSTRAP_MEMBER_ORDER=['ecmwf_ifs025_ensemble','ncep_gefs05','gem_global_ensemble','google_weathernext2_ensemble','bom_access_global_ensemble','ecmwf_ifs_europe_ensemble'] as const;
const ENSEMBLE_BOOTSTRAP_MEAN_ORDER=['ecmwf_ifs025_ensemble_mean','ncep_gefs05_ensemble_mean','cmc_gem_geps_ensemble_mean','google_weathernext2_ensemble_mean','bom_access_global_ensemble_mean','ecmwf_ifs_europe_ensemble_mean','ncep_gefs_ensemble_mean_seamless'] as const;
const ENSEMBLE_BOOTSTRAP_MEMBER_IDS=new Set<string>(ENSEMBLE_BOOTSTRAP_MEMBER_ORDER);
const ENSEMBLE_BOOTSTRAP_MEAN_IDS=new Set<string>(ENSEMBLE_BOOTSTRAP_MEAN_ORDER);
function ensembleBootstrapModels(models:EnsembleModel[],ids:Set<string>,order:readonly string[]){const rank=new Map(order.map((id,index)=>[id,index])),seen=new Set<string>();return models.filter(model=>ids.has(model.id)&&model.maxDays>=10).sort((a,b)=>(rank.get(a.id)??99)-(rank.get(b.id)??99)).filter(model=>{if(seen.has(model.independenceGroup))return false;seen.add(model.independenceGroup);return true})}
async function memberEnsembleBootstrap(lat:number,lon:number,signal?:AbortSignal){
 const selected=ensembleBootstrapModels(selectedEnsembleModels(lat,lon),ENSEMBLE_BOOTSTRAP_MEMBER_IDS,ENSEMBLE_BOOTSTRAP_MEMBER_ORDER);if(!selected.length)return null;
 const loaded=await loadEnsembleUnits(selected,1,async model=>parseModelMembers(await fetchEnsembleWeather(lat,lon,Math.min(14,model.maxDays),model.id,signal,'temperature_2m,precipitation,wind_speed_10m,wind_gusts_10m','foreground'),model),signal,1);if(signal?.aborted)throw new DOMException('Abgebrochen','AbortError');
 const results=loaded.successes.map(row=>row.value),days=aggregateMembers(results,[],{minimumIndependentGroups:1,minimumWeightedSamples:5});if(!results.length||days.length<7)return null;
 return{days:days.slice(0,14),models:results.map(result=>result.model.label),runs:[],scenarios:buildEnsembleScenarios(results,days),bootstrap:true} satisfies EnsembleForecastBundle;
}
async function meanEnsembleBootstrap(lat:number,lon:number,signal?:AbortSignal){
 const selected=ensembleBootstrapModels(selectedMeanModels(lat,lon),ENSEMBLE_BOOTSTRAP_MEAN_IDS,ENSEMBLE_BOOTSTRAP_MEAN_ORDER);if(!selected.length)return null;
 const loaded=await loadEnsembleUnits(selected,1,async definition=>pseudoModelFromMeanSpread(await fetchEnsembleWeather(lat,lon,Math.min(14,definition.maxDays),definition.id,signal,'temperature_2m,temperature_2m_spread,precipitation,precipitation_spread','foreground'),definition),signal,1);if(signal?.aborted)throw new DOMException('Abgebrochen','AbortError');
 const results=loaded.successes.map(row=>row.value),days=aggregateMembers(results,[],{minimumIndependentGroups:1,minimumWeightedSamples:5});if(!results.length||days.length<7)return null;
 return{days:days.slice(0,14),models:results.map(result=>result.model.label),runs:[],scenarios:[],bootstrap:true} satisfies EnsembleForecastBundle;
}
async function fastEnsembleBootstrap(lat:number,lon:number,signal?:AbortSignal){
 const bootstrapDeadline=ensembleDeadline(signal,ENSEMBLE_BOOTSTRAP_TIMEOUT_MS,'Ensemble-Schnellstart hat das Zeitbudget überschritten.'),bootstrapSignal=bootstrapDeadline.signal;
 try{const mean=await meanEnsembleBootstrap(lat,lon,bootstrapSignal);if(mean)return mean;if(bootstrapSignal.aborted)return null;return await memberEnsembleBootstrap(lat,lon,bootstrapSignal)}catch(error){if(signal?.aborted)throw error;return null}finally{bootstrapDeadline.cleanup()}
}

async function meanFallback(lat:number,lon:number,signal?:AbortSignal,priority:OpenMeteoPriority='normal'){
 const selected=selectedMeanModels(lat,lon),loaded=await loadEnsembleUnits(selected,6,async definition=>pseudoModelFromMeanSpread(await fetchEnsembleWeather(lat,lon,definition.maxDays,definition.id,signal,'temperature_2m,temperature_2m_spread,precipitation,precipitation_spread',priority),definition),signal);
 if(signal?.aborted)throw new DOMException('Abgebrochen','AbortError');const results=loaded.successes.map(row=>row.value),runs=await ensembleModelRunMetas(loaded.attempts,selected,signal),days=aggregateMembers(results,runs),scenarios:EnsembleScenarioCluster[]=[],activeModels=results.map(result=>result.model);
