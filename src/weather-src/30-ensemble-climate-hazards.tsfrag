function aggregateEventPrecipitationProbability(rows:{model:EnsembleModel;totals:number[]}[],date:string,startTime:string,endTime:string,runs:ModelRunMeta[]=[]):EventPrecipitationProbabilityAssessment|null{
 const raw=rows.filter(row=>row.totals.length>=2),lead=eventLeadDayIndex(date),runById=new Map(runs.map(run=>[run.id,run])),freshness=(model:EnsembleModel)=>effectiveModelFreshness(model,runById.get(model.id)),familyRows=new Map<string,typeof raw>();for(const row of raw){const key=`${row.model.independenceGroup}::${row.model.family}`,items=familyRows.get(key)??[];items.push(row);familyRows.set(key,items)}const usable=[...familyRows.values()].map(items=>[...items].sort((a,b)=>variantSelectionScore(b.model,lead,freshness(b.model))-variantSelectionScore(a.model,lead,freshness(a.model)))[0]),groupCounts=new Map<string,number>();for(const row of usable)groupCounts.set(row.model.independenceGroup,(groupCounts.get(row.model.independenceGroup)??0)+1);const values:{value:number;weight:number}[]=[],groups=new Set<string>();let memberCount=0;
 for(const row of usable){const divisor=Math.max(1,groupCounts.get(row.model.independenceGroup)??1),weight=modelDayWeight(row.model,lead,row.totals.length,'precipitation',freshness(row.model))/divisor;if(weight<=0)continue;groups.add(row.model.independenceGroup);memberCount+=row.totals.length;for(const total of row.totals)values.push({value:Math.max(0,total),weight})}
