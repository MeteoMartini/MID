 const endDate=wallEnd<wallStart?new Date(Date.parse(`${date}T00:00:00Z`)+86400000).toISOString().slice(0,10):date,epoch=(value:string)=>localIsoEpoch(value,weather.timezone,Number(weather.utc_offset_seconds)||0),start=epoch(`${date}T${startTime}`),end=epoch(`${endDate}T${endTime}`),duration=end-start,stamps=times.map(epoch),totals:number[]=[];
