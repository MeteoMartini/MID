{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mid.invalid/contracts/wis2-normalized-observation.schema.json",
  "title": "MID official observation v1",
  "type": "object",
  "required": ["schema", "data"],
  "properties": {
    "schema": {"const": "mid-official-observation-v1"},
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lat", "lon", "reportTime"],
        "properties": {
          "stationId": {"type": ["string", "number"]},
          "name": {"type": "string"},
          "lat": {"type": "number", "minimum": -90, "maximum": 90},
          "lon": {"type": "number", "minimum": -180, "maximum": 180},
          "reportTime": {"type": "string"},
          "temp": {"type": ["number", "null"]},
          "dewp": {"type": ["number", "null"]},
          "relativeHumidity": {"type": ["number", "null"]},
          "pressureMsl": {"type": ["number", "null"]},
          "windSpeed": {"type": ["number", "null"]},
          "windDirection": {"type": ["number", "null"]},
          "windGust": {"type": ["number", "null"]},
          "precipitation": {"type": ["number", "null"]}
        }
      }
    }
  }
}
