# Ein einziger Cloudflare Worker versorgt Stationsdaten, optionale hyperlokale Netze
# und amtliche CAP-Warnungen.
VITE_METAR_PROXY_URL=https://your-worker.example.workers.dev/

# Optional: dieselbe Adresse explizit auch als Radar-Nowcast-Proxy setzen.
# Ohne diese Variable verwendet MID automatisch VITE_METAR_PROXY_URL.
VITE_RADAR_PROXY_URL=https://your-worker.example.workers.dev/

# Optional: dieselbe Adresse explizit auch als Warnungsproxy setzen.
# Ein zweiter Worker ist nicht erforderlich.
VITE_ALERT_PROXY_URL=https://your-worker.example.workers.dev/

# API-Zugangsdaten für WU, Netatmo, Synoptic und Xweather gehören ausschließlich
# als Secrets in den Cloudflare Worker – niemals als öffentliche VITE_* Variable.


# Optional: gleichursprünglicher Worker-Pfad. Nur verwenden, wenn die Domain
# diesen Pfad tatsächlich per Cloudflare Route/Rewrite zum Worker leitet.
# VITE_WORKER_SAME_ORIGIN_PATH=/api/mid-worker

# Optional: durch Komma, Semikolon oder Leerzeichen getrennte Ersatzendpunkte.
# MID probiert sie bei Netzwerk-, DNS-, CORS- oder HTTP-Fehlern automatisch.
# VITE_WORKER_FALLBACK_URLS=https://worker-fallback.example.com/,https://your-worker.example.workers.dev/
