# Ein einziger Cloudflare Worker versorgt Stationsdaten, optionale hyperlokale Netze
# und amtliche CAP-Warnungen.
VITE_METAR_PROXY_URL=https://your-worker.example.workers.dev/

# Optional: dieselbe Adresse explizit auch als Radar-Nowcast-Proxy setzen.
# Ohne diese Variable verwendet MID automatisch VITE_METAR_PROXY_URL.
VITE_RADAR_PROXY_URL=https://your-worker.example.workers.dev/

# Optional: dieselbe Adresse explizit auch als Warnungsproxy setzen.
# Ein zweiter Worker ist nicht erforderlich.
VITE_ALERT_PROXY_URL=https://your-worker.example.workers.dev/

# API-Zugangsdaten für WU, Netatmo, Synoptic und Xweather gehören ausschließlich
# als Secrets in den Cloudflare Worker – niemals als öffentliche VITE_* Variable.


# Optional: gleichursprünglicher Worker-Pfad. Nur verwenden, wenn die Domain
# diesen Pfad tatsächlich per Cloudflare Route/Rewrite zum Worker leitet.
# VITE_WORKER_SAME_ORIGIN_PATH=/api/mid-worker

# Optional: durch Komma, Semikolon oder Leerzeichen getrennte Ersatzendpunkte.
# MID probiert sie bei Netzwerk-, DNS-, CORS- oder HTTP-Fehlern automatisch.
# VITE_WORKER_FALLBACK_URLS=https://worker-fallback.example.com/,https://your-worker.example.workers.dev/

# Optionale amtliche Flugwetterquellen für Events/Aktivität „Flug“.
# Diese Werte ausschließlich als Secrets im Cloudflare Worker setzen, NICHT als VITE_* Variablen:
# MID_WIFS_API_KEY=<WIFS API key>       # WAFS SIGWX beider WAFC; WIFS-Zugang/Autorisierung erforderlich
# MID_KNMI_API_KEY=<KNMI Open Data key> # KNMI AIRMET/SIGMET Amsterdam FIR; optional für relevante Standorte
# MID v0.9.47.0 – optionale amtliche Beobachtungs-/Regionalensemble-Adapter.
# Diese Werte gehören AUSSCHLIESSLICH in die Cloudflare-Worker-Konfiguration,
# niemals als öffentliche VITE_* Variablen in GitHub Pages. Die direkt angebundenen
# Quellen DWD SYNOP, SMHI, FMI, NWS und ECCC benötigen keinen dieser Adapter.
# MID_DWD_ROAD_WEATHER_POINT_ENDPOINT=https://...   # numerische DWD-GMA/SWS-Punktdaten; sourceType road-weather
# MID_METEOSWISS_OBSERVATION_POINT_ENDPOINT=https://... # numerische SwissMetNet-Punktdaten
# MID_KNMI_OBSERVATION_POINT_ENDPOINT=https://...  # numerische KNMI-10-min-Punktdaten
# MID_AEMET_API_KEY=...                            # AEMET OpenData, nur als Worker-Secret
# MID_METEOFRANCE_OBSERVATION_POINT_ENDPOINT=https://... # numerische amtliche FR-Punktdaten
# MID_KNMI_HARMONIE_EPS_POINT_ENDPOINT=https://... # numerische HARMONIE-EPS-Zeitreihe im Open-Meteo-hourly-Schema
# MID_KNMI_HARMONIE_EPS_POINT_TOKEN=...            # optionales Bearer-Token des eigenen Adapters
# MID_ECCC_REPS_POINT_ENDPOINT=https://...          # numerische REPS-Zeitreihe im Open-Meteo-hourly-Schema
# MID_ECCC_REPS_POINT_TOKEN=...                     # optionales Bearer-Token des eigenen Adapters
#
# Punktadapter müssen bereits dekodierte numerische JSON-Werte liefern. MID dekodiert
# bewusst keine rohen BUFR-/GRIB-Dateien im Cloudflare Worker und rekonstruiert keine
# probabilistischen Mitglieder aus Kartenfarben oder anderen Bildprodukten.


# MID v0.9.69.1 – DWD ICON-D2-RUC / RUC-EPS.
# Rohes DWD-GRIB2 wird ausschließlich außerhalb des Cloudflare Workers vorverarbeitet.
# Der bevorzugte produktive Pfad ist der private R2-Binding-Adapter MID_DWD_RUC_DATA.
# Deterministik, EPS-Summary, native Event-Member und Lookup werden run-immutable veröffentlicht;
# ein R2-Bucket oder MID_RUC_PIPELINE_ENABLED dürfen wegen des Kostenvertrags erst nach
# ausdrücklicher Freigabe eingerichtet/aktiviert werden. MID_DWD_RUC_DATA ist ein Worker-
# Binding und deshalb bewusst kein .env-Wert. Als kostenneutraler Legacy-Fallback bleiben:
# MID_DWD_RUC_POINT_ENDPOINT=https://...             # bereits dekodierte deterministische JSON-Stundenreihe
# MID_DWD_RUC_POINT_TOKEN=...                        # optionales Bearer-Token
# MID_DWD_RUC_EPS_POINT_ENDPOINT=https://...         # bereits dekodierte RUC-EPS-Member/Punktreihe
# MID_DWD_RUC_EPS_POINT_TOKEN=...                    # optionales Bearer-Token
#
# Copernicus CLMS LCM10 kann MID dagegen direkt über die CDSE Statistical API abfragen.
# Hierfür einen OAuth Client im Copernicus Data Space / Sentinel Hub Dashboard anlegen
# und beide Werte ausschließlich als Cloudflare-Worker-Secrets setzen:
# MID_CDSE_CLIENT_ID=...
# MID_CDSE_CLIENT_SECRET=...
# MID_CLMS_LCM_YEAR=2020                             # optional; LCM10 ist derzeit als Basisjahr 2020 verfügbar


# MID v0.9.53.45 – private Netatmo station / indoor sensors / ventilation assistant.
# Set these ONLY in Cloudflare Worker settings (not as public VITE_* variables).
# MID_PUSH_SUBSCRIPTIONS is the existing KV binding also used by Web Push.
# NETATMO_CLIENT_ID=...
# NETATMO_CLIENT_SECRET=...
# MID_STATION_TOKEN_KEY=...   # long random secret; derives the AES-GCM key for stored OAuth tokens
#
# For ventilation notifications the existing Web-Push setup is also required:
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:...
# plus the existing Worker cron trigger (recommended: */5 * * * *).
